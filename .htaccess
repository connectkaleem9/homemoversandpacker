# ==========================================================================
# homemoverandpaker.com — Apache / LiteSpeed configuration
#
# Order matters here: security and canonicalisation run before the rewrites
# that map clean URLs onto the underlying .php files.
# ==========================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ------------------------------------------------------------------------
# 1. Force HTTPS
#    Two conditions so this works behind a load balancer or CDN that
#    terminates TLS and forwards X-Forwarded-Proto.
# ------------------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------------------
# 2. Canonical host — non-www is the canonical version
# ------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------------------
# 3. Never expose .php in public URLs
#    /services/villa-movers.php  ->  301  ->  /services/villa-movers/
#
#    GET only, and never /forms/ or /admin/. The form endpoints are POST
#    targets: a 301 on a POST makes the browser re-issue it as a GET with no
#    body, so every quote and contact submission would arrive empty.
#    THE_REQUEST matches the whole request line regardless of method, so the
#    method has to be excluded explicitly. The dashboard is excluded because it
#    is not public SEO surface and its own redirects point at real .php paths.
# ------------------------------------------------------------------------
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{REQUEST_URI} !^/(forms|admin)/
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L,NE]

# ------------------------------------------------------------------------
# 4. Enforce a single trailing-slash form for directory-style URLs
#    /services/villa-movers  ->  301  ->  /services/villa-movers/
#
#    GET only, for the same reason as rule 3.
# ------------------------------------------------------------------------
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{REQUEST_URI} !^/admin/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ /$1/ [R=301,L,NE]

# ------------------------------------------------------------------------
# 5. Dynamic XML sitemap
# ------------------------------------------------------------------------
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ------------------------------------------------------------------------
# 6. Project pages
#    /projects/<slug>/  and  /ar/projects/<slug>/  ->  projects/project.php
#
#    The slugs are created in the admin dashboard, so there is no file on disk
#    to match — this has to come before the Arabic strip and the generic
#    clean-URL rules, both of which would fall through to a 404.
#    /projects/ itself is untouched: it has its own index.php.
# ------------------------------------------------------------------------
RewriteRule ^(?:ar/)?projects/[a-z0-9][a-z0-9-]*/?$ projects/project.php [L]

# ------------------------------------------------------------------------
# 7. Arabic — /ar/... is served by the same PHP files as English
#    /ar/                            -> index.php
#    /ar/services/                   -> services/index.php
#    /ar/services/villa-movers/      -> services/villa-movers.php
#
#    The rewrite is internal, so REQUEST_URI still carries the /ar prefix and
#    includes/i18n.php reads the language back out of it. router.php does the
#    same thing for the local development server.
# ------------------------------------------------------------------------
RewriteRule ^ar/?$ index.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1index.php -f
RewriteRule ^ar/(.*/)?$ $1index.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^ar/(.+?)/?$ $1.php [L]

# ------------------------------------------------------------------------
# 8. Clean URLs -> real files
#    /about-us/                  -> about-us.php
#    /services/villa-movers/     -> services/villa-movers.php
#    /locations/dubai/           -> locations/dubai.php
#    /blog/some-article/         -> blog/some-article.php
#    Directory index files (/services/, /blog/) are matched first.
# ------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1index.php -f
RewriteRule ^(.*/)?$ $1index.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# ------------------------------------------------------------------------
# 9. Error documents
# ------------------------------------------------------------------------
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php

# ------------------------------------------------------------------------
# 10. Security headers
# ------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HSTS — enable only once HTTPS is confirmed working on the live domain.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # Form endpoints must never be indexed.
  <FilesMatch "^(quote-submit|contact-submit)\.php$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>

  # Remove the identifying header where the server allows it.
  Header always unset X-Powered-By
</IfModule>

<IfModule mod_php.c>
  php_flag expose_php off
</IfModule>

# ------------------------------------------------------------------------
# 11. Protect sensitive files and directories
# ------------------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|jsonl|ini|md|yml|yaml|lock|bak|dist|sh|bat)$">
  Require all denied
</FilesMatch>

# The project brief is an internal document. robots.txt is the only .txt that
# is meant to be served, so this is named explicitly rather than denying .txt.
<Files "briefprompt.txt">
  Require all denied
</Files>

# Server-specific settings and credentials. Already covered by the
# /includes/ rule below; named here too because of what it contains.
<Files "env.php">
  Require all denied
</Files>

# A .git directory in a document root lets anyone reconstruct the whole source
# tree. The FilesMatch "^\." rule above matches file NAMES, so it would not
# cover /.git/config — this does. Deployment keeps the repository outside the
# web root anyway; this is here so an in-place clone is not a disaster.
RedirectMatch 404 ^/(\.git|\.github|storage|database|includes)(/|$)

# ------------------------------------------------------------------------
# 12. Compression
# ------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE application/rss+xml image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2 font/woff
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ------------------------------------------------------------------------
# 13. Browser caching
#     Assets are versioned with ?v= in the markup, so they can cache hard.
# ------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"

  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 hour"
  ExpiresByType text/xml                  "access plus 1 hour"

  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"

  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|avif|jpg|jpeg|png|svg|ico|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(php|html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # The root favicon and the manifest are requested by fixed name, so they
  # cannot carry the ?v= that lets everything else cache for a year — an
  # immutable year on these would mean a new icon never reaching anyone who
  # has already visited. A week, and they revalidate.
  <FilesMatch "^(favicon\.ico|site\.webmanifest)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------
# 14. Correct MIME types
# ------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/x-icon          .ico
  AddType image/webp            .webp
  AddType image/avif            .avif
  AddType image/svg+xml         .svg
  AddType font/woff2            .woff2
  AddType font/woff             .woff
  AddType application/json      .json
  AddCharset UTF-8              .html .css .js .xml .json .svg
</IfModule>

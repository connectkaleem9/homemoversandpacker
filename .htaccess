# ==========================================================================
# homemoverandpaker.com — Apache / LiteSpeed configuration
#
# Order matters here: security and canonicalisation run before the rewrites
# that map clean URLs onto the underlying .php files.
# ==========================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ------------------------------------------------------------------------
# 1. Force HTTPS
#    Two conditions so this works behind a load balancer or CDN that
#    terminates TLS and forwards X-Forwarded-Proto.
# ------------------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------------------
# 2. Canonical host — non-www is the canonical version
# ------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------------------
# 3. Never expose .php in public URLs
#    /services/villa-movers.php  ->  301  ->  /services/villa-movers/
# ------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L,NE]

# ------------------------------------------------------------------------
# 4. Enforce a single trailing-slash form for directory-style URLs
#    /services/villa-movers  ->  301  ->  /services/villa-movers/
# ------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ /$1/ [R=301,L,NE]

# ------------------------------------------------------------------------
# 5. Dynamic XML sitemap
# ------------------------------------------------------------------------
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ------------------------------------------------------------------------
# 6. Clean URLs -> real files
#    /about-us/                  -> about-us.php
#    /services/villa-movers/     -> services/villa-movers.php
#    /locations/dubai/           -> locations/dubai.php
#    /blog/some-article/         -> blog/some-article.php
#    Directory index files (/services/, /blog/) are matched first.
# ------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1index.php -f
RewriteRule ^(.*/)?$ $1index.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# ------------------------------------------------------------------------
# 7. Error documents
# ------------------------------------------------------------------------
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php

# ------------------------------------------------------------------------
# 8. Security headers
# ------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HSTS — enable only once HTTPS is confirmed working on the live domain.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # Form endpoints must never be indexed.
  <FilesMatch "^(quote-submit|contact-submit)\.php$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>

  # Remove the identifying header where the server allows it.
  Header always unset X-Powered-By
</IfModule>

<IfModule mod_php.c>
  php_flag expose_php off
</IfModule>

# ------------------------------------------------------------------------
# 9. Protect sensitive files and directories
# ------------------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|jsonl|ini|md|yml|yaml|lock|bak|dist|sh)$">
  Require all denied
</FilesMatch>

RedirectMatch 404 ^/(storage|database|includes)(/|$)

# ------------------------------------------------------------------------
# 10. Compression
# ------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2 font/woff
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ------------------------------------------------------------------------
# 11. Browser caching
#     Assets are versioned with ?v= in the markup, so they can cache hard.
# ------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"

  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 1 hour"
  ExpiresByType text/xml                  "access plus 1 hour"

  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"

  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|avif|jpg|jpeg|png|svg|ico|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(php|html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------
# 12. Correct MIME types
# ------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp            .webp
  AddType image/avif            .avif
  AddType image/svg+xml         .svg
  AddType font/woff2            .woff2
  AddType font/woff             .woff
  AddType application/json      .json
  AddCharset UTF-8              .html .css .js .xml .json .svg
</IfModule>

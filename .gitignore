# Runtime data — never commit leads or logs
# Keep the directories (PHP writes into them) but never the contents
/storage/*.jsonl
/storage/*.json
/storage/logs/*
!/storage/logs/.gitkeep
/uploads/*
!/uploads/.gitkeep

# Local environment
.env
.env.local
*.local.php

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# Dependencies / build output
/vendor/
/node_modules/

# Archives and dumps
*.zip
*.tar.gz
*.sql.gz
*-backup.sql

# Design references — not part of the website
/design/
assets/images/_ref.png

# Runtime data — never commit leads or logs
# Keep the directories (PHP writes into them) but never the contents
/storage/*.jsonl
/storage/*.json
/storage/logs/*
!/storage/logs/.gitkeep
/uploads/*
!/uploads/.gitkeep
# The execution guard must ship with the code — an uploads directory without
# it on a fresh deploy is the whole risk of accepting uploads at all.
!/uploads/.htaccess
!/uploads/projects/
/uploads/projects/*
!/uploads/projects/.gitkeep

# Local environment
.env
.env.local
*.local.php

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# Dependencies / build output
/vendor/
/node_modules/

# Archives and dumps
*.zip
*.tar.gz
*.sql.gz
*-backup.sql

# Design references — not part of the website
/design/
assets/images/_ref.png

# Server-specific settings and credentials — never committed.
# includes/env.example.php is the template.
/includes/env.php

# Runtime records written by the admin dashboard and the review form.
/storage/data/
/storage/admin.json
/storage/admin-attempts.json
